{
  "address": "e1UkVXrsWoQW97Yw8eCP1NJ3kcdqLYNgwQwidL7Lg89",
  "metadata": {
    "name": "tiber_twins",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "The twins program: creates Romulus (ROM) and Remus (REM), runs their bonding curves on the Tiber exchange as the pools' hook (the 2% buy tax for the sister, the 2% sell burn, the anti-sniper fee and the 1% buy limit), graduates each curve into a pool with liquidity locked for good, and releases the treasury on its schedule."
  },
